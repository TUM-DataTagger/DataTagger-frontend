	"version": "1.4.0",
	"private": true,
	"description": "",
	"keywords": [],
	"license": "UNLICENSED",
	"directories": {
		"lib": "src"
	},
	"files": [
		".next",
		"public"
	],
	"type": "module",
	"scripts": {
		"test": "vitest run --config ../../vitest.config.ts --coverage.reportsDirectory coverage/website --project website-unit --project website-browser",
		"test:unit": "vitest run --config ../../vitest.config.ts --coverage.reportsDirectory coverage/website-unit --project website-unit",
		"test:browser": "vitest run --config ../../vitest.config.ts --coverage.reportsDirectory coverage/website-browser --project website-browser",
		"test:browser:install": "playwright install chromium",
		"test:coverage": "vitest run --config ../../vitest.config.ts --coverage --coverage.reportsDirectory coverage/website-unit --project website-unit",
		"version-info": "node version-info.js",
		"build": "pnpm run build:prod",
		"build:check": "pnpm run version-info && tsc --noEmit",
		"build:openapi": "openapi-typescript http://localhost:8000/api/schema --output=src/util/openapiSchema.ts --array-length --empty-objects-unknown",
		"build:local": "pnpm run build:prod",
		"build:prod": "pnpm run build:next",
		"build:next": "pnpm run version-info && next build",
		"preview": "next start",
		"dev": "next dev",
		"lint": "pnpm run build:check && oxfmt --check && oxlint --tsconfig=tsconfig.eslint.json --type-aware src __tests__",
		"format": "pnpm run build:check && oxfmt && oxlint --tsconfig=tsconfig.eslint.json --type-aware src __tests__ --fix --fix-suggestions",
		"fmt": "pnpm run format"
	},
