{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "fdm-frontend",
	"version": "0.0.0",
	"private": true,
	"description": "",
	"keywords": [],
	"type": "module",
	"scripts": {
		"build": "pnpm --recursive build",
		"dev": "pnpm --recursive dev",
		"test": "pnpm run test:unit && pnpm run test:browser",
		"test:unit": "vitest run --project website-unit",
		"test:browser": "vitest run --project website-browser",
		"test:browser:install": "pnpm --filter @fdm-frontend/website exec playwright install chromium",
		"test:coverage": "vitest run --coverage --coverage.reportsDirectory coverage --project website-unit --project website-browser",
		"lint": "pnpm --recursive lint",
		"format": "pnpm --recursive format",
		"fmt": "pnpm format",
		"prepare": "is-ci || husky",
		"update": "pnpm --recursive update --interactive",
		"update:latest": "pnpm --recursive update --interactive --latest"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-istanbul": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"commitlint-config-jira": "^1.6.4",
		"commitlint-plugin-jira-rules": "^1.6.4",
		"eslint-config-neon": "^0.5.3",
		"eslint-plugin-react-compiler": "19.1.0-rc.2",
		"husky": "^9.1.7",
		"is-ci": "^4.1.0",
		"lint-staged": "^17.3.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
